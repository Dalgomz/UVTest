{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "types": ["vite/client"],
    "jsx": "react-jsx",

    "strict": true,
    "noEmit": true,

    "allowJs": false,
    "checkJs": false,

    "skipLibCheck": true,
    "isolatedModules": true,

    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}